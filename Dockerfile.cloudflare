# Multi-stage build for Cloudflare Containers
# Compile with Rust toolchain, run on minimal runtime

# Deliberately unpinned: `latest`/`slim`/`stable`, never a version number.
# This project runs its dependencies at latest on purpose (Dependabot,
# `cargo update`, weekly `cargo audit`/`pnpm audit`) rather than pinning and
# periodically catching up — applied here to the compiler and the base OS too.
# `slim`, not the full image: same policy, a smaller package set to scan and
# patch — this stage is discarded after the build, but a smaller stage is
# still a smaller window regardless. `these_images_track_latest_on_purpose` in
# the test suite fails if either `FROM` line names a specific version instead.
FROM rust:slim AS builder

WORKDIR /app

# Copy source files
COPY Cargo.toml Cargo.lock* ./
COPY src ./src
COPY index.html ./index.html
COPY client.js ./client.js
# nova-wasm/pkg is wasm-pack's committed *output* (scripts/build-nova-wasm.sh
# produces it, not this build): src/routes/page.rs pulls it in with
# include_str!/include_bytes!, so it must be in the build context or
# `cargo build` fails looking for a file that exists in the repo but not here.
COPY nova-wasm/pkg ./nova-wasm/pkg
# nova-operator/ is a workspace member the main crate depends on as a path
# dependency (protocol/crypto types shared with the standalone operator
# binary — session/nova_operator.rs's module doc) — `Cargo.toml`/
# `Cargo.lock` reference it, so `cargo build` needs it present in this
# build context even though the built image never runs that binary itself
# (operators run on their own machines, never inside this container).
COPY nova-operator ./nova-operator

# No build-dependency install here: nothing in the dependency tree links
# OpenSSL (`grep openssl Cargo.lock` finds nothing — the server does no
# outbound TLS of its own; Cloudflare terminates it), so the `pkg-config`/
# `libssl-dev` this used to install were dead weight in the one stage that
# still runs `apt-get`.
#
# `--bin infinite-chat`, not a bare `cargo build --release`: the workspace
# also contains `nova-operator`'s own binary target, which this image has no
# use for (it runs on operators' own machines) and which would otherwise be
# built and discarded here for nothing.
RUN cargo build --release --bin infinite-chat

# distroless, not a general-purpose OS: no shell, no package manager, no `ls`,
# no `cat` — nothing a container-escape or a dependency RCE could use once it
# is in, beyond the one binary this image exists to run. `ldd` against the
# compiled binary names exactly `libc.so.6`, `libm.so.6` and `libgcc_s.so.1`,
# which is what `cc-debian12` provides (`static-debian12` provides none of
# them and needs a fully static musl binary instead — attempted, and the musl
# target's linker invocation broke under this machine's x86_64-under-arm64
# emulation; `cc-debian12` needed no cross-compilation and is what actually
# built and ran).
#
# `:nonroot`, not `:latest`: the tag itself selects the built-in unprivileged
# user (`nonroot`, uid 65532) rather than defaulting to root and needing a
# `USER` line to opt out — there is no `useradd` here to run one with anyway.
# Still an unpinned, moving tag — `nonroot` is a variant selector, not a
# version, and both are allowed by `these_images_track_latest_on_purpose`.
#
# No `ca-certificates` layer: this server makes no outbound HTTPS calls to
# verify a certificate for (§9.4 — no reqwest, no client TLS anywhere in the
# dependency tree), so the package was never doing anything at runtime either.
FROM gcr.io/distroless/cc-debian12:nonroot AS runtime

WORKDIR /app

# The binary is the only artifact: index.html, client.js and robots.txt are all
# embedded into it at compile time (include_str! / a literal in
# robots_txt_handler), which is the entire reason to include_str! them rather
# than read from disk — this image has exactly one thing that can be out of
# date with itself. Copying them here too would be dead weight that could
# mislead someone into thinking editing them post-build changes what is served.
#
# `--chown=nonroot:nonroot`: BuildKit sets ownership at the COPY layer itself,
# which is what a distroless target needs — there is no `chown` binary in it
# to run one afterwards.
COPY --from=builder --chown=nonroot:nonroot /app/target/release/infinite-chat /app/infinite-chat

# Belt and suspenders on top of the `:nonroot` tag already selecting this user:
# explicit here so a future edit that swaps the base image back to a
# root-default tag does not silently start running as root again.
USER nonroot

# Cloudflare Containers expects port 3000 by default
ENV PORT=3000
ENV RUST_LOG=info

# Expose the port for Cloudflare to connect
EXPOSE 3000

# Exec form is the only form: distroless has no shell to interpret a shell-form
# CMD in the first place.
CMD ["./infinite-chat"]

# Cloudflare Containers uses SIGINT for graceful shutdown
STOPSIGNAL SIGINT
