# Multi-stage build for Cloudflare Containers
# Compile with Rust toolchain, run on minimal runtime

# Pinned, not `rust:latest`: an unpinned tag means today's build and
# tomorrow's build of the same commit can pull a different compiler and a
# different base OS layer with no diff to review — the classic unreproducible-
# build supply-chain gap. Bump deliberately, alongside the MSRV in Cargo.toml.
FROM rust:1.97-bookworm AS builder

# Install minimal build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy source files
COPY Cargo.toml Cargo.lock* ./
COPY src ./src
COPY index.html ./index.html
COPY client.js ./client.js

# Build release binary with optimizations
RUN cargo build --release

# Runtime image - use minimal Alpine for smaller image
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The binary is the only artifact: index.html, client.js and robots.txt are all
# embedded into it at compile time (include_str! / a literal in
# robots_txt_handler), which is the entire reason to include_str! them rather
# than read from disk — this image has exactly one thing that can be out of
# date with itself. Copying them here too would be dead weight that could
# mislead someone into thinking editing them post-build changes what is served.
COPY --from=builder /app/target/release/infinite-chat /app/infinite-chat

# Runs as an unprivileged user, not root. The server binds a single high port
# and holds no capability that needs it — root here buys nothing and costs
# everything a container-escape or a future memory-safety bug could reach.
RUN useradd --system --no-create-home --shell /usr/sbin/nologin chat \
  && chown chat:chat /app/infinite-chat
USER chat

# Cloudflare Containers expects port 3000 by default
ENV PORT=3000
ENV RUST_LOG=info

# Expose the port for Cloudflare to connect
EXPOSE 3000

# Use exec form for proper signal handling
CMD ["./infinite-chat"]

# Cloudflare Containers uses SIGINT for graceful shutdown
STOPSIGNAL SIGINT
