# Every tunable the server has, and the fact that it has one.
#
# The companion to scripts/client-inventory.toml, for the same reason: a
# constant deleted is a limit that stops being enforced, and nothing fails to
# compile because the tests that used it went in the same edit.
#
# This records existence only. What each value should *be* is argued in
# config.rs, where it lives next to the reasoning, and asserted by
# `the_memory_budget_still_closes` and the boundary tests.
#
# Removing a line here is how you say the tunable is genuinely gone.

ALLOWED_ATTACHMENT_MIMES
CLEANUP_BATCH_SIZE
DISCONNECTED_USER_RETENTION
DUPLICATE_MESSAGE_WINDOW
EMPTY_ROOM_CLEANUP_DELAY
ESTIMATED_MESSAGE_SIZE
HEARTBEAT_INTERVAL
HEARTBEAT_TIMEOUT
IDLE_CLOSE_CODE
INACTIVE_TIMEOUT
IP_BAN_DURATION
IP_COUNTER_RETENTION
MAIN_ROOM
MAIN_ROOM_FADE_IDLE
MAIN_ROOM_FADE_KEEP
MAX_ATTACHMENT_BYTES
MAX_ATTACHMENT_DIMENSION
MAX_CONCURRENT_CONNECTIONS_PER_IP
MAX_CONCURRENT_USERS
MAX_MESSAGES_PER_ROOM
MAX_MESSAGES_PER_WINDOW
MAX_MESSAGE_AGE
MAX_MESSAGE_LEN
MAX_PAYLOAD_SIZE
MAX_REACTIONS_PER_MESSAGE
MAX_RENDERED_MESSAGE_LEN
MAX_REPLY_AUTHOR_LEN
MAX_REPLY_PREVIEW_LEN
MAX_ROOMS
MAX_ROOM_ATTACHMENT_BYTES
MAX_ROOM_JOIN_ATTEMPTS
MAX_ROOM_NAME_LEN
MAX_SUSPICIOUS_EVENTS
MAX_TOTAL_ROOMS_MEMORY
MAX_USERS_PER_ROOM
MEMORY_GC_MIN_INTERVAL
MEMORY_SOFT_LIMIT_RATIO
MIN_ROOM_NAME_LEN
RATE_LIMIT_WINDOW
REACTION_MIN_INTERVAL
READ_RECEIPT_MIN_INTERVAL
RESERVED_ROOM_NAMES
RESOURCE_CLEANUP_INTERVAL
ROOM_CLEANUP_INTERVAL
ROOM_NAME_REGEX
SUSPICIOUS_ACTIVITY_WINDOW
TYPING_EVENT_MIN_INTERVAL
USER_IDLE_MESSAGE_TIMEOUT
VERSION
