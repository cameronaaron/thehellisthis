# Rust build artifacts
# NOTE: Cargo.lock IS tracked — this is a binary crate, and the deployed
# container must build from the exact dependency set that CI tested.
/target/
# nova-wasm/ is a separate crate (scripts/build-nova-wasm.sh). Its own
# target/ is exactly as much a build artifact as the root one; only
# nova-wasm/pkg/ — wasm-pack's *output* — is meant to be committed.
/nova-wasm/target/

# Coverage reports (regenerate with `cargo tarpaulin`)
tarpaulin-report.*
cobertura.xml
lcov.info
# `--engine llvm` instruments build scripts too; one drops its raw profile
# in the repo root rather than target/coverage/ like everything else.
*.profraw

# Dependencies
cloudflare/node_modules/
cloudflare/.wrangler/

# Environment & secrets
.env
.env.local
.env.*.local

# OS & IDE
.DS_Store
*.log
*.pdb
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Mutation testing output
mutants.out/
mutants.out.old/
