{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infinite-chat",
  "main": "src/index.ts",
  // Kept current deliberately: the Workers runtime gates behaviour changes on
  // this date, so leaving it pinned in the past opts out of fixes indefinitely.
  "compatibility_date": "2026-07-01",
  
  // Custom domain configuration
  "routes": [
    {
      "pattern": "thehellisthis.com/*",
      "zone_name": "thehellisthis.com"
    },
    {
      "pattern": "www.thehellisthis.com/*",
      "zone_name": "thehellisthis.com"
    }
  ],

  // Wrangler already infers this as false once `routes` is set — stated so
  // that inference is a documented decision rather than an implicit side
  // effect somebody has to rediscover. The site has exactly one intended
  // entry point; a live *.workers.dev URL would be a second, unbranded one
  // answering the same rooms.
  "workers_dev": false,

  // No Logpush destination is configured, so this is already the default;
  // stated for the same reason as `workers_dev` above — a deliberate "no"
  // reads differently from an unset field nobody has looked at yet.
  "logpush": false,

  // Disable observability for cost savings (no active logging needed): the
  // Worker itself does no per-request console.log-ing (see 1e91e242, which
  // removed the last of it), so Workers Logs would ingest invocation records
  // nobody reads. The app's own logs go through the container's RUST_LOG /
  // stdout pipeline instead, which this setting has no effect on.
  "observability": {
    "enabled": false
  },

  // Runs the Worker itself close to the one pinned container/Durable Object
  // instance (`max_instances: 1` below) rather than close to whichever
  // visitor is asking. With a single global backend, every visitor pays the
  // Worker-to-container hop regardless of where the Worker runs; "smart"
  // lets Cloudflare learn where that backend actually is and place the
  // Worker there instead of at the visitor's nearest edge, which is the
  // configuration Smart Placement is for — a fixed backend and a globally
  // distributed caller.
  "placement": {
    "mode": "smart"
  },

  // Check Cloudflare's edge cache before running the Worker at all, honouring
  // whatever Cache-Control the container's response carries. Only /app.js
  // (content-hashed, immutable) actually wants that; every other route the
  // Rust server serves sets an explicit `Cache-Control: no-store` for exactly
  // this reason — see `build_router` in src/startup.rs.
  "cache": {
    "enabled": true
  },

  // Container configuration for the Rust WebSocket server
  "containers": [
    {
      // Path to Dockerfile in parent directory
      "image": "../Dockerfile.cloudflare",
      "class_name": "InfiniteChatContainer",
      "name": "infinite-chat-container",
      // Hobby tier: single instance to minimize memory costs (~$0.50-2/month)
      "max_instances": 1,
      // Explicit rather than relying on the default ("dev", deprecated): 256
      // MiB / 1/16 vCPU. src/config.rs's MAX_TOTAL_ROOMS_MEMORY is sized
      // against exactly this instance type — raising it here means revisiting
      // that constant too (see the memory budget invariant test).
      "instance_type": "lite"
    }
  ],
  
  // Durable Objects binding
  "durable_objects": {
    "bindings": [
      {
        "class_name": "InfiniteChatContainer",
        "name": "CHAT_CONTAINER"
      }
    ]
  },
  
  // Required migration for new SQLite-backed Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InfiniteChatContainer"]
    }
  ]
}
