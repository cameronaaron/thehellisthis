{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infinite-chat",
  "main": "src/index.ts",
  // Kept current deliberately: the Workers runtime gates behaviour changes on
  // this date, so leaving it pinned in the past opts out of fixes indefinitely.
  "compatibility_date": "2026-07-01",
  
  // Custom domain configuration
  "routes": [
    {
      "pattern": "thehellisthis.com/*",
      "zone_name": "thehellisthis.com"
    },
    {
      "pattern": "www.thehellisthis.com/*",
      "zone_name": "thehellisthis.com"
    }
  ],
  
  // Disable observability for cost savings (no active logging needed)
  "observability": {
    "enabled": true
  },

  // Check Cloudflare's edge cache before running the Worker at all, honouring
  // whatever Cache-Control the container's response carries. Only /app.js
  // (content-hashed, immutable) actually wants that; every other route the
  // Rust server serves sets an explicit `Cache-Control: no-store` for exactly
  // this reason — see `build_router` in src/startup.rs.
  "cache": {
    "enabled": true
  },

  // Container configuration for the Rust WebSocket server
  "containers": [
    {
      // Path to Dockerfile in parent directory
      "image": "../Dockerfile.cloudflare",
      "class_name": "InfiniteChatContainer",
      "name": "infinite-chat-container",
      // Hobby tier: single instance to minimize memory costs (~$0.50-2/month)
      "max_instances": 1
    }
  ],
  
  // Durable Objects binding
  "durable_objects": {
    "bindings": [
      {
        "class_name": "InfiniteChatContainer",
        "name": "CHAT_CONTAINER"
      }
    ]
  },
  
  // Required migration for new SQLite-backed Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InfiniteChatContainer"]
    }
  ]
}
